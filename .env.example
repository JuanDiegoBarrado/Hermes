# ==============================================================================
# HERMES - Variables de entorno
# ==============================================================================
# Copia este fichero a .env y edítalo: cp .env.example .env
# .env está en el .gitignore, así que las contraseñas que pongas ahí nunca llegan al repo. Una
# variable de entorno ya definida manda sobre la del .env.

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
# Usuario con el que corre el contenedor. Tiene que ser el mismo que el AIRFLOW_UID del .env de
# Omnis: omnis-storage crea con él los Excels de temp/, y si no es el mismo, Hermes no puede
# moverlos a done/. Solo lo usa el docker-compose.yaml
HERMES_UID=1000

# ------------------------------------------------------------------------------
# Modo servidor (serve)
# ------------------------------------------------------------------------------
# Cada cuánto se despierta Hermes como mucho, en segundos, para volver a mirar el reloj y los jobs
HERMES_WAKEUP_SECONDS=900

# ------------------------------------------------------------------------------
# Storage de Omnis (los jobs que entregan a su landing zone)
# ------------------------------------------------------------------------------
# Si falta alguna y un job activado la usa, la pasada de serve falla y no corre ningún job.
# URL del storage, sin / al final. En Docker, http://host.docker.internal:<STORAGE_PORT de Omnis>;
# ejecutando Hermes a mano en la misma máquina, http://localhost:<STORAGE_PORT>
OMNIS_STORAGE_DATA_DIR=http://host.docker.internal:9000
# Uno de los usuarios del STORAGE_USERS de Omnis, como usuario:contraseña
OMNIS_STORAGE_AUTH=producer:change-me
# La carpeta temp/ del storage de Omnis en esta máquina, sin / al final, relativa a la raíz de
# Hermes o absoluta: de donde se leen los Excels subidos a POST /temp/<tipo>. En Docker, el
# docker-compose.yaml la monta y se la pasa al contenedor como /data/temp
OMNIS_STORAGE_TEMP_DIR=../Omnis/omnis-storage/data/temp

# ------------------------------------------------------------------------------
# Avisos de fallos
# ------------------------------------------------------------------------------
# A quién se envía un correo cuando falla un job en modo servidor. Si falta alguna de estas
# (salvo SMTP_PORT), no se envía ningún correo
ALERT_EMAIL=
# Servidor SMTP por el que se envían los correos, como SMTP_USER, que es también el remitente. El
# puerto 465 usa TLS, cualquier otro STARTTLS. Gmail: smtp.gmail.com, 587 y una contraseña de
# aplicación (no la de la cuenta)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
